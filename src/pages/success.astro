---
// Where the newsletter form lands after a signup, matching the live Framer page:
// the full-bleed GIF, one line of thanks, one way back. Copy is kept word for word.
// Colours are fixed black on white rather than themed: they sit on the same GIF
// in light and dark, so theming them would only hurt contrast.
// Measured on the live page: 20px bold text, 50px gap, 20px button padding.
import Head from "../components/Head.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <Head />
    <meta name="robots" content="noindex" />
  </head>
  <body class="success">
    <img class="success-bg" src="/success.gif" alt="" />
    <main class="success-body">
      <p>Thanks love &lt;3</p>
      <a href="/">Woahh! take me back</a>
    </main>
  </body>
</html>

<style>
  .success {
    margin: 0;
    min-height: 100dvh;
    background: #fff;
  }
  .success-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .success-body {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 50px;
    padding: 0 16px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    color: #000;
    text-align: center;
  }
  .success-body p {
    margin: 0;
  }
  .success-body a {
    padding: 20px;
    background: #fff;
    color: #000;
    text-decoration: none;
  }
</style>
