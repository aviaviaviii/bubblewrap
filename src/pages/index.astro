---
import Page from "../layouts/Page.astro";
import GiftGrid from "../components/GiftGrid.astro";
import { sections } from "../lib/gifts";

const { newest, byPrice } = sections();
---

<Page>
  <GiftGrid heading="NEW" gifts={newest} eager fullRows />
  <GiftGrid heading="SORTED BY PRICE" gifts={byPrice} priceFilter />
</Page>
