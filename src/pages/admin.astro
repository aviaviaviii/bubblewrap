---
// /admin: a small CMS for the gift list, phone included.
//
// Three views on one page, picked by the URL hash so the browser's back button works:
//   (none)        the list: every gift, live and draft, newest first. Click a row to edit;
//                 drafts have Publish right in the list
//   #new          add a gift
//   #edit/<slug>  edit one
// Add and edit share one form (one form, one set of checks, in src/lib/gift-core.mjs).
//
// Behind a password gate: nothing shows until the password checks out. The page itself
// carries no gift data (it's static, public on the custom domain, noindex); the list
// is fetched from src/pages/api/gift.ts with the password, which also re-checks it on
// every save. The password is kept in sessionStorage so a reload doesn't ask again;
// it's gone when the tab closes, or on Lock.
//
// Borrowed from Framer's CMS table (the reference): one row per item with image, title,
// status, price, tags and date, and click-to-edit. Kept our own look: Space Mono, plain
// hairlines, no pills or colour for status. On phones the table becomes stacked rows.
// Show/Hide on the password: typing a long password blind on a phone is where the
// "Wrong password" mix-ups came from.
// Above the list: search (title and tags), status and tag filters, and a sort menu.
// Sorting: the Title, Status, Price and Date headers are clickable (click again to
// reverse), and the Sort menu does the same. They're one control, not two: a header
// click just sets the menu, so they can't disagree. The menu stays because the headers
// are gone on phones. Image and Tags don't sort; neither has a useful order.
// The choices survive going in and out of an edit page (in memory, reset on reload or Lock).
// Thumbnails open the full image in a <dialog> (Escape, the close button or a click
// outside closes it), above the row's click-to-edit area.
// Delete lives at the bottom of the edit page only, as a two-step: "Delete gift" swaps
// in "Delete <title>? It comes off the site." with Delete and Keep, so one stray tap
// can't remove a gift. No red: the words carry it. Git history keeps deleted gifts.
// Left out on purpose (not asked for yet): bulk actions.
import Head from "../components/Head.astro";
import { site } from "../site.config";
---

<!doctype html>
<html lang="en">
  <head>
    <Head title="Admin · bubblewrap" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="admin" data-nav-tags={JSON.stringify(site.navTags)}>
    <!-- ---------- gate ---------- -->
    <main id="gate" class="narrow">
      <h1>bubblewrap admin</h1>
      <form id="unlock" novalidate>
        <label>Password
          <span class="password-row">
            <input id="password" type="password" autocomplete="current-password" />
            <button type="button" class="reveal" aria-pressed="false" aria-controls="password">Show</button>
          </span>
        </label>
        <button type="submit" class="primary">Open</button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </main>

    <!-- ---------- list ---------- -->
    <main id="list-view" class="wide" hidden>
      <header class="bar">
        <div>
          <h1>Gifts</h1>
          <p class="count" id="count"></p>
        </div>
        <div class="bar-actions">
          <button type="button" class="secondary" id="lock">Lock</button>
          <a class="primary" href="#new">Add</a>
        </div>
      </header>
      <p class="status" id="list-status" role="status" aria-live="polite"></p>
      <div class="toolbar">
        <input type="search" id="q" placeholder="Search" aria-label="Search gifts" autocomplete="off" />
        <select id="f-status" aria-label="Status">
          <option value="">All</option>
          <option value="live">Live</option>
          <option value="draft">Drafts</option>
        </select>
        <select id="f-tag" aria-label="Tag"><option value="">All tags</option></select>
        <select id="sort" aria-label="Sort">
          <option value="drafts">Drafts first</option>
          <option value="new">Newest</option>
          <option value="old">Oldest</option>
          <option value="price-desc">Price, high to low</option>
          <option value="price-asc">Price, low to high</option>
          <option value="live">Live first</option>
          <option value="title">Title, A to Z</option>
          <option value="title-desc">Title, Z to A</option>
        </select>
      </div>
      <p class="empty" id="empty" hidden>No gifts match. <button type="button" class="text-button" id="clear">Clear</button></p>
      <div class="table" role="table" aria-label="Gifts">
        <div class="row head" role="row">
          <span role="columnheader" class="c-img"><span class="sr">Image</span></span>
          <span role="columnheader" class="c-title"><button type="button" class="sort-head" data-col="title">Title<span class="sort-mark" aria-hidden="true"></span></button></span>
          <span role="columnheader" class="c-status"><button type="button" class="sort-head" data-col="status">Status<span class="sort-mark" aria-hidden="true"></span></button></span>
          <span role="columnheader" class="c-price"><button type="button" class="sort-head" data-col="price">Price<span class="sort-mark" aria-hidden="true"></span></button></span>
          <span role="columnheader" class="c-tags">Tags</span>
          <span role="columnheader" class="c-date"><button type="button" class="sort-head" data-col="date">Date<span class="sort-mark" aria-hidden="true"></span></button></span>
        </div>
        <div id="rows" role="rowgroup"></div>
      </div>
    </main>

    <dialog id="viewer" aria-label="Image">
      <button type="button" class="viewer-close" aria-label="Close">×</button>
      <img alt="" />
      <p class="viewer-title"></p>
    </dialog>

    <!-- ---------- add / edit ---------- -->
    <main id="form-view" class="narrow" hidden>
      <a class="back" href="#">← All gifts</a>
      <h1 id="form-heading">Add a gift</h1>
      <form id="gift" novalidate>
        <label>Title<input name="title" autocomplete="off" /></label>

        <label><span>Image<span class="hint" id="image-hint" hidden> · leave empty to keep it</span></span>
          <input name="image" type="file" accept="image/*" />
        </label>
        <img class="preview" alt="" hidden />

        <label>Price in ₹<input name="price" inputmode="numeric" autocomplete="off" placeholder="2499" /></label>

        <fieldset>
          <legend>Tags</legend>
          <div class="tags" id="tag-boxes"></div>
          <label class="new-tag">New tag<input name="tags" autocomplete="off" placeholder="optional" /></label>
        </fieldset>

        <label>Link<input name="link" type="url" inputmode="url" autocomplete="off" placeholder="https://" /></label>

        <fieldset>
          <legend>Status</legend>
          <div class="tags">
            <label class="tag"><input type="radio" name="status" value="live" checked />Live</label>
            <label class="tag"><input type="radio" name="status" value="draft" />Draft, hidden from the site</label>
          </div>
        </fieldset>

        <label>Date<input name="date" type="date" /></label>

        <div class="actions">
          <button type="submit" class="primary">Add gift</button>
          <a class="secondary" href="#">Cancel</a>
        </div>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
      <div class="delete-zone" id="delete-zone" hidden>
        <button type="button" class="secondary" id="delete-start">Delete gift</button>
        <div id="delete-confirm" hidden>
          <p id="delete-question"></p>
          <div class="actions">
            <button type="button" class="primary" id="delete-yes">Delete</button>
            <button type="button" class="secondary" id="delete-no">Keep</button>
          </div>
        </div>
        <p class="status" id="delete-status" role="status" aria-live="polite"></p>
      </div>
    </main>

    <script>
      type Gift = { slug: string; title: string; image: string; price: number; tags: string[]; date: string | null; link: string; draft: boolean };

      const $ = <T extends Element>(sel: string, root: ParentNode = document) => root.querySelector(sel) as T;
      const KEY = "bw-admin";
      const navTags: string[] = JSON.parse(document.body.dataset.navTags || "[]");
      const inr = new Intl.NumberFormat("en-IN", { maximumFractionDigits: 0 });
      const dateFmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric" });
      const showDate = (d: string | null) => (d ? dateFmt.format(new Date(d + "T00:00:00")) : "");

      const gate = $<HTMLElement>("#gate");
      const listView = $<HTMLElement>("#list-view");
      const formView = $<HTMLElement>("#form-view");
      const password = $<HTMLInputElement>("#password");
      const unlockStatus = $<HTMLElement>("#unlock .status");
      const listStatus = $<HTMLElement>("#list-status");
      const rows = $<HTMLElement>("#rows");
      const form = $<HTMLFormElement>("#gift");
      const formStatus = $<HTMLElement>(".status", form);
      const submit = $<HTMLButtonElement>("button[type=submit]", form);
      const preview = $<HTMLImageElement>(".preview", form);
      const fileInput = form.elements.namedItem("image") as HTMLInputElement;

      let pass = "";
      let gifts: Gift[] = [];

      const say = (el: HTMLElement, text: string, ok = false) => {
        el.textContent = text;
        el.dataset.ok = String(ok);
      };
      const problem = (e: unknown) => (e instanceof TypeError ? "Couldn't reach the site. Check your connection and try again" : (e as Error).message);

      // Every request carries the password and an action; the server answers JSON.
      async function send(action: string, body = new FormData()) {
        body.set("action", action);
        body.set("password", pass);
        const res = await fetch("/api/gift", { method: "POST", body });
        const out = await res.json().catch(() => ({ error: "Something went wrong. Try again" }));
        if (!res.ok) throw Object.assign(new Error(out.error), { status: res.status });
        return out;
      }

      // ---------- gate ----------

      $<HTMLButtonElement>(".reveal").addEventListener("click", (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const showing = password.type === "text";
        password.type = showing ? "password" : "text";
        btn.textContent = showing ? "Show" : "Hide";
        btn.setAttribute("aria-pressed", String(!showing));
        password.focus();
      });

      async function unlock(candidate: string) {
        pass = candidate;
        const out = await send("list");
        gifts = out.gifts;
        try { sessionStorage.setItem(KEY, candidate); } catch {}
        gate.hidden = true;
        route();
      }

      function lock(message = "") {
        pass = "";
        gifts = [];
        rows.replaceChildren(); // nothing about the gifts stays in the page once locked
        form.reset();
        q.value = fStatus.value = fTag.value = "";
        sortBy.value = "drafts";
        try { sessionStorage.removeItem(KEY); } catch {}
        password.value = "";
        listView.hidden = formView.hidden = true;
        gate.hidden = false;
        say(unlockStatus, message);
        password.focus();
      }
      $<HTMLButtonElement>("#lock").addEventListener("click", () => lock());

      $<HTMLFormElement>("#unlock").addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!password.value) return say(unlockStatus, "Still needs the password");
        const btn = $<HTMLButtonElement>("#unlock button[type=submit]");
        btn.disabled = true;
        say(unlockStatus, "");
        try {
          await unlock(password.value);
        } catch (err) {
          pass = "";
          say(unlockStatus, problem(err));
        } finally {
          btn.disabled = false;
        }
      });

      // ---------- routing ----------

      function route() {
        if (!pass) return;
        const hash = location.hash.slice(1);
        const editing = hash.startsWith("edit/") ? gifts.find((g) => g.slug === decodeURIComponent(hash.slice(5))) : null;
        const adding = hash === "new";
        listView.hidden = adding || Boolean(editing);
        formView.hidden = !listView.hidden;
        if (adding) fillForm(null);
        else if (editing) fillForm(editing);
        else renderList();
        window.scrollTo(0, 0);
      }
      window.addEventListener("hashchange", route);

      // ---------- list ----------

      const q = $<HTMLInputElement>("#q");
      const fStatus = $<HTMLSelectElement>("#f-status");
      const fTag = $<HTMLSelectElement>("#f-tag");
      const sortBy = $<HTMLSelectElement>("#sort");

      const byDate = (a: Gift, b: Gift) => (b.date ?? "").localeCompare(a.date ?? "");
      // "Drafts first" is the default: drafts are the ones waiting on you, and by date
      // alone the July drafts sat ~200 rows down.
      const sorts: Record<string, (a: Gift, b: Gift) => number> = {
        drafts: (a, b) => Number(b.draft) - Number(a.draft) || byDate(a, b),
        new: byDate,
        // Undated gifts (one, Akela) go last here too, not first.
        old: (a, b) => Number(!a.date) - Number(!b.date) || -byDate(a, b),
        "price-desc": (a, b) => b.price - a.price,
        "price-asc": (a, b) => a.price - b.price,
        live: (a, b) => Number(a.draft) - Number(b.draft) || byDate(a, b),
        title: (a, b) => a.title.localeCompare(b.title, "en", { sensitivity: "base" }),
        "title-desc": (a, b) => b.title.localeCompare(a.title, "en", { sensitivity: "base" }),
      };

      function tagOptions() {
        const keep = fTag.value;
        const tags = [...new Set(gifts.flatMap((g) => g.tags))].sort();
        fTag.replaceChildren(new Option("All tags", ""), ...tags.map((t) => new Option(t, t)));
        fTag.value = tags.includes(keep) ? keep : "";
      }

      // Each sortable header: its first click, then the reverse, and which way each runs
      // (for the arrow and aria-sort).
      const heads: Record<string, [string, string]> = {
        title: ["title", "title-desc"],
        status: ["drafts", "live"],
        price: ["price-desc", "price-asc"],
        date: ["new", "old"],
      };
      const ascending = new Set(["title", "live", "price-asc", "old"]);

      function markHeads() {
        for (const b of document.querySelectorAll<HTMLButtonElement>(".sort-head")) {
          const active = heads[b.dataset.col!].includes(sortBy.value);
          const up = ascending.has(sortBy.value);
          $<HTMLElement>(".sort-mark", b).textContent = active ? (up ? " ↑" : " ↓") : "";
          b.parentElement!.setAttribute("aria-sort", active ? (up ? "ascending" : "descending") : "none");
          b.classList.toggle("active", active);
        }
      }

      for (const b of document.querySelectorAll<HTMLButtonElement>(".sort-head")) {
        b.addEventListener("click", () => {
          const [first, second] = heads[b.dataset.col!];
          sortBy.value = sortBy.value === first ? second : first;
          renderList();
        });
      }

      function renderList() {
        markHeads();
        tagOptions();
        const term = q.value.trim().toLowerCase();
        const shown = gifts
          .filter((g) => !fStatus.value || (fStatus.value === "draft") === g.draft)
          .filter((g) => !fTag.value || g.tags.includes(fTag.value))
          .filter((g) => !term || g.title.toLowerCase().includes(term) || g.tags.some((t) => t.includes(term)))
          .sort(sorts[sortBy.value] ?? sorts.drafts);
        const drafts = gifts.filter((g) => g.draft).length;
        const total = `${gifts.length} gifts${drafts ? ` · ${drafts} draft${drafts === 1 ? "" : "s"}` : ""}`;
        $<HTMLElement>("#count").textContent = shown.length === gifts.length ? total : `Showing ${shown.length} of ${total}`;
        $<HTMLElement>("#empty").hidden = shown.length > 0;
        rows.replaceChildren(...shown.map(row));
      }

      q.addEventListener("input", renderList);
      for (const el of [fStatus, fTag, sortBy]) el.addEventListener("change", renderList);
      $<HTMLButtonElement>("#clear").addEventListener("click", () => {
        q.value = fStatus.value = fTag.value = "";
        renderList();
        q.focus();
      });

      // ---------- full-size image ----------

      const viewer = $<HTMLDialogElement>("#viewer");
      function view(g: Gift) {
        $<HTMLImageElement>("img", viewer).src = g.image;
        $<HTMLElement>(".viewer-title", viewer).textContent = g.title;
        viewer.showModal();
      }
      $<HTMLButtonElement>(".viewer-close", viewer).addEventListener("click", () => viewer.close());
      // A click on the dim backdrop lands on the dialog element itself.
      viewer.addEventListener("click", (e) => { if (e.target === viewer) viewer.close(); });

      function cell(cls: string, ...kids: (Node | string)[]) {
        const s = document.createElement("span");
        s.setAttribute("role", "cell");
        s.className = cls;
        s.append(...kids);
        return s;
      }

      function row(g: Gift) {
        const r = document.createElement("div");
        r.className = "row";
        r.setAttribute("role", "row");

        const img = document.createElement("img");
        img.src = g.image;
        img.alt = "";
        img.loading = "lazy";
        img.decoding = "async";
        // A gift added minutes ago has no image on the site until the rebuild finishes.
        img.onerror = () => img.classList.add("missing");
        const thumb = document.createElement("button");
        thumb.type = "button";
        thumb.className = "thumb";
        thumb.setAttribute("aria-label", `View image of ${g.title}`);
        thumb.append(img);
        thumb.addEventListener("click", () => view(g));

        // The title link stretches over the whole row (see .row-link::after), so any
        // click on the row opens it, while Publish stays its own button above it.
        const link = document.createElement("a");
        link.className = "row-link";
        link.href = `#edit/${encodeURIComponent(g.slug)}`;
        link.textContent = g.title;

        const status = cell("c-status");
        if (g.draft) {
          const label = document.createElement("span");
          label.className = "draft";
          label.textContent = "Draft";
          const pub = document.createElement("button");
          pub.type = "button";
          pub.className = "secondary small";
          pub.textContent = "Publish";
          pub.addEventListener("click", () => publish(g, pub));
          status.append(label, pub);
        } else {
          status.append("Live");
        }

        const price = cell("c-price", `₹${inr.format(g.price)}`);
        price.dataset.tags = ` · ${g.tags.join(", ")}`; // shown beside the price on phones

        r.append(
          cell("c-img", thumb),
          cell("c-title", link),
          status,
          price,
          cell("c-tags", g.tags.join(", ")),
          cell("c-date", showDate(g.date)),
        );
        return r;
      }

      async function publish(g: Gift, btn: HTMLButtonElement) {
        btn.disabled = true;
        btn.textContent = "Publishing";
        try {
          const body = new FormData();
          body.set("slug", g.slug);
          await send("publish", body);
          await refresh();
          say(listStatus, `Published ${g.title}. On the site in about a minute.`, true);
        } catch (err) {
          say(listStatus, problem(err));
          btn.disabled = false;
          btn.textContent = "Publish";
        }
      }

      async function refresh() {
        gifts = (await send("list")).gifts;
        if (!listView.hidden) renderList();
      }

      // ---------- add / edit form ----------

      let editing: Gift | null = null;

      function tagBoxes(selected: string[]) {
        const inUse = [...new Set(gifts.flatMap((g) => g.tags))];
        const all = [...navTags, ...inUse.filter((t) => !navTags.includes(t)).sort()];
        $<HTMLElement>("#tag-boxes").replaceChildren(
          ...all.map((t) => {
            const l = document.createElement("label");
            l.className = "tag";
            const box = document.createElement("input");
            box.type = "checkbox";
            box.name = "tags";
            box.value = t;
            box.checked = selected.includes(t);
            l.append(box, t);
            return l;
          }),
        );
        return new Set(all);
      }

      function fillForm(g: Gift | null) {
        editing = g;
        form.reset();
        resetDelete(g);
        say(formStatus, "");
        $<HTMLElement>("#form-heading").textContent = g ? "Edit gift" : "Add a gift";
        submit.textContent = g ? "Save" : "Add gift";
        $<HTMLElement>("#image-hint").hidden = !g;
        const known = tagBoxes(g?.tags ?? []);
        const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
        preview.hidden = !g;
        if (g) preview.src = g.image;
        field("title").value = g?.title ?? "";
        field("price").value = g ? String(g.price) : "";
        field("link").value = g?.link ?? "";
        // An undated gift stays undated unless you pick a date; filling in today here
        // would quietly move it under NEW on the next save.
        field("date").value = g ? (g.date ?? "") : new Date().toISOString().slice(0, 10);
        $<HTMLInputElement>(`input[name=status][value=${g?.draft ? "draft" : "live"}]`, form).checked = true;
        $<HTMLInputElement>(".new-tag input", form).value = (g?.tags ?? []).filter((t) => !known.has(t)).join(", ");
      }

      fileInput.addEventListener("change", () => {
        const f = fileInput.files?.[0];
        preview.hidden = !f && !editing;
        if (f) preview.src = URL.createObjectURL(f);
      });

      // Vercel refuses uploads over 4.5MB, and phone photos are often bigger.
      // Anything over 3.5MB is shrunk here to 1600px first (the server makes the
      // final 800px webp). Webp where the browser can make it, keeping transparency;
      // otherwise JPEG.
      async function shrink(f: File): Promise<Blob> {
        if (f.size <= 3.5 * 1024 * 1024) return f;
        const bmp = await createImageBitmap(f);
        const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
        const c = document.createElement("canvas");
        c.width = Math.round(bmp.width * scale);
        c.height = Math.round(bmp.height * scale);
        c.getContext("2d")!.drawImage(bmp, 0, 0, c.width, c.height);
        const as = (type: string) => new Promise<Blob | null>((r) => c.toBlob(r, type, 0.9));
        const webp = await as("image/webp");
        return webp?.type === "image/webp" ? webp : (await as("image/jpeg"))!;
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const f = fileInput.files?.[0];
        const field = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value.trim();
        const missing = [
          !field("title") && "a title",
          !f && !editing && "an image",
          !field("price") && "a price",
          !new FormData(form).getAll("tags").some((t) => String(t).trim()) && "a tag",
          !field("link") && "a link",
        ].filter(Boolean);
        if (missing.length) return say(formStatus, `Still needs ${missing.join(", ")}`);

        const was = editing;
        submit.disabled = true;
        submit.textContent = was ? "Saving" : "Adding";
        say(formStatus, "");
        try {
          const body = new FormData(form);
          if (f) body.set("image", await shrink(f), f.name);
          else body.delete("image");
          if (was) body.set("slug", was.slug);
          const out = await send(was ? "edit" : "add", body);
          await refresh();
          const when = out.where === "github" ? " On the site in about a minute." : "";
          say(listStatus, `${was ? "Saved" : "Added"} ${out.title}${out.draft ? " as a draft" : ""}.${out.draft ? "" : when}`, true);
          location.hash = "";
        } catch (err) {
          if ((err as { status?: number }).status === 401) return lock("Wrong password. Enter it again");
          say(formStatus, problem(err));
        } finally {
          submit.disabled = false;
          submit.textContent = editing ? "Save" : "Add gift";
        }
      });

      // ---------- delete ----------

      const deleteZone = $<HTMLElement>("#delete-zone");
      const deleteStart = $<HTMLButtonElement>("#delete-start");
      const deleteConfirm = $<HTMLElement>("#delete-confirm");
      const deleteYes = $<HTMLButtonElement>("#delete-yes");
      const deleteStatus = $<HTMLElement>("#delete-status");

      function resetDelete(g: Gift | null) {
        deleteZone.hidden = !g;
        deleteConfirm.hidden = true;
        deleteStart.hidden = false;
        deleteYes.disabled = false;
        deleteYes.textContent = "Delete";
        say(deleteStatus, "");
      }

      deleteStart.addEventListener("click", () => {
        if (!editing) return;
        $<HTMLElement>("#delete-question").textContent = `Delete ${editing.title}? It comes off the site.`;
        deleteStart.hidden = true;
        deleteConfirm.hidden = false;
        $<HTMLButtonElement>("#delete-no").focus();
      });
      $<HTMLButtonElement>("#delete-no").addEventListener("click", () => {
        resetDelete(editing);
        deleteStart.focus();
      });
      deleteYes.addEventListener("click", async () => {
        if (!editing) return;
        const g = editing;
        deleteYes.disabled = true;
        deleteYes.textContent = "Deleting";
        say(deleteStatus, "");
        try {
          const body = new FormData();
          body.set("slug", g.slug);
          const out = await send("delete", body);
          await refresh();
          say(listStatus, `Deleted ${g.title}.${out.where === "github" ? " Off the site in about a minute." : ""}`, true);
          location.hash = "";
        } catch (err) {
          if ((err as { status?: number }).status === 401) return lock("Wrong password. Enter it again");
          say(deleteStatus, problem(err));
          deleteYes.disabled = false;
          deleteYes.textContent = "Delete";
        }
      });

      // ---------- start ----------

      let saved = "";
      try { saved = sessionStorage.getItem(KEY) ?? ""; } catch {}
      if (saved) {
        unlock(saved).catch(() => lock());
      } else {
        password.focus();
      }
    </script>

    <!-- is:global because rows are built by the script above, and Astro's scoped
         styles only reach elements written in this template. This page has its own
         stylesheet, so nothing leaks to the site. -->
    <style is:global>
      .admin main { margin: 0 auto; padding: 40px 16px 64px; }
      .admin main.narrow { max-width: 420px; }
      .admin main.wide { max-width: 1100px; padding-left: 24px; padding-right: 24px; }
      [hidden] { display: none !important; }
      h1 { font-size: 20px; margin: 0 0 20px; }
      form { display: flex; flex-direction: column; gap: 20px; }
      label { display: flex; flex-direction: column; gap: 6px; }
      input:not([type="checkbox"]):not([type="radio"]):not([type="file"]) {
        font: inherit;
        font-size: 16px; /* 16px stops iOS zooming into the field */
        padding: 12px;
        border: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
        border-radius: 0;
        background: var(--input-bg);
        color: var(--input-fg);
        min-width: 0;
      }
      input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--fg); outline-offset: 1px; }
      .password-row { display: flex; }
      .password-row input { flex: 1; }
      .reveal {
        font: inherit;
        font-size: 14px;
        padding: 0 14px;
        border: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
        border-left: 0;
        border-radius: 0;
        background: var(--input-bg);
        color: var(--muted);
        cursor: pointer;
      }
      input[type="file"] { font: inherit; font-size: 14px; }
      .preview { width: 110px; height: 120px; object-fit: contain; }
      fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
      legend { padding: 0; margin-bottom: 6px; }
      .tags { display: flex; flex-wrap: wrap; gap: 8px 16px; }
      .tag { flex-direction: row; align-items: center; gap: 6px; font-size: 14px; }
      .tag input { width: 18px; height: 18px; margin: 0; accent-color: var(--fg); }
      .hint { color: var(--muted); }

      .primary, .secondary { font: inherit; border-radius: 0; cursor: pointer; text-align: center; display: inline-block; }
      .primary {
        font-size: 16px;
        font-weight: 700;
        padding: 15px 18px;
        border: 0;
        background: var(--button-bg);
        color: #fff;
      }
      .secondary {
        font-size: 14px;
        padding: 10px 14px;
        border: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
        background: transparent;
        color: var(--fg);
      }
      .secondary.small { font-size: 12px; padding: 6px 10px; }
      button:disabled { cursor: progress; opacity: 0.7; }
      .actions { display: flex; gap: 12px; }
      .actions .primary { flex: 1; }
      .actions .secondary { display: flex; align-items: center; }
      .status { margin: 0; min-height: 1.4em; font-size: 14px; color: var(--muted); }
      .status[data-ok="true"] { color: var(--fg); }
      .delete-zone { margin-top: 48px; padding-top: 24px; border-top: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
      .delete-zone p { margin: 0; font-size: 14px; }
      #delete-confirm { display: flex; flex-direction: column; gap: 12px; width: 100%; }
      #delete-confirm .actions .primary { flex: 1; }
      .back { display: inline-block; margin-bottom: 24px; font-size: 14px; color: var(--muted); }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

      /* ---------- list ---------- */
      .bar { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 8px; }
      .bar h1 { margin: 0; }
      .count { margin: 6px 0 0; font-size: 14px; color: var(--muted); }
      .bar-actions { display: flex; gap: 12px; align-items: center; }
      .bar-actions .primary { padding: 10px 22px; font-size: 14px; }
      #list-status { margin: 8px 0 12px; }

      .table { font-size: 14px; }
      .row {
        position: relative;
        display: grid;
        grid-template-columns: 56px minmax(0, 3fr) 150px 90px minmax(0, 1.2fr) 110px;
        align-items: center;
        gap: 16px;
        padding: 10px 8px;
        border-top: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
      }
      .row.head { color: var(--muted); font-size: 12px; padding-top: 0; padding-bottom: 8px; border-top: 0; }
      .sort-head { font: inherit; color: inherit; padding: 4px 0; border: 0; background: none; cursor: pointer; text-align: left; }
      .sort-head:hover, .sort-head.active { color: var(--fg); }
      .row:not(.head):hover { background: color-mix(in srgb, var(--fg) 5%, transparent); }
      .c-img img { width: 48px; height: 52px; object-fit: contain; display: block; }
      .thumb { position: relative; z-index: 1; padding: 0; border: 0; background: none; cursor: zoom-in; display: block; }

      .toolbar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
      .toolbar input { flex: 1 1 220px; }
      .toolbar select {
        font: inherit;
        font-size: 14px;
        padding: 0 10px;
        min-height: 46px;
        border: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
        border-radius: 0;
        background: var(--input-bg);
        color: var(--input-fg);
      }
      .empty { font-size: 14px; color: var(--muted); padding: 24px 8px; margin: 0; }
      .text-button { font: inherit; padding: 0; border: 0; background: none; color: var(--fg); text-decoration: underline; cursor: pointer; }

      #viewer {
        padding: 16px;
        border: 0;
        background: var(--bg);
        color: var(--fg);
        max-width: min(92vw, 860px);
        max-height: 92vh;
      }
      #viewer::backdrop { background: rgb(0 0 0 / 0.6); }
      #viewer img { display: block; max-width: 100%; max-height: calc(92vh - 96px); margin: 0 auto; object-fit: contain; }
      .viewer-title { margin: 12px 0 0; font-size: 14px; text-align: center; }
      .viewer-close {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 40px;
        height: 40px;
        font: inherit;
        font-size: 22px;
        border: 0;
        background: var(--bg);
        color: var(--fg);
        cursor: pointer;
      }
      .c-img img.missing { visibility: hidden; }
      .c-price, .c-date { font-variant-numeric: tabular-nums; }
      .c-tags, .c-date { color: var(--muted); }
      .c-status { display: flex; align-items: center; gap: 10px; }
      .c-status .draft { color: var(--muted); }
      .c-status button { position: relative; z-index: 1; } /* above the row link */
      .row-link { overflow-wrap: break-word; }
      .row-link::after { content: ""; position: absolute; inset: 0; }

      /* Phones: the table becomes stacked rows. Image on the left; title, then price
         and tags, then status and date underneath. The column header goes. */
      @media (max-width: 720px) {
        .admin main.wide { padding-left: 16px; padding-right: 16px; }
        .row.head { display: none; }
        .row {
          grid-template-columns: 48px minmax(0, 1fr);
          grid-template-areas: "img title" "img meta" "img status";
          column-gap: 12px;
          row-gap: 2px;
          padding: 12px 0;
        }
        .c-img { grid-area: img; align-self: start; }
        .c-title { grid-area: title; }
        .c-price { grid-area: meta; font-size: 12px; color: var(--muted); }
        .c-tags { display: none; }
        .c-status { grid-area: status; font-size: 12px; color: var(--muted); margin-top: 4px; }
        .c-date { display: none; }
        .c-status .secondary.small { font-size: 13px; padding: 11px 16px; } /* a thumb-sized target */
        /* Search, then Status and Tags side by side, then Sort on its own line.
           Three menus on one line cut the sort label to "Drafts f…". */
        .toolbar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .toolbar input, .toolbar #sort { grid-column: 1 / -1; }
        .toolbar select { min-width: 0; }
        .c-price::after { content: attr(data-tags); }
      }
    </style>
  </body>
</html>
