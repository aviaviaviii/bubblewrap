---
import { formatPrice, type Gift } from "../lib/gifts";

interface Props {
  heading: string;
  gifts: Gift[];
  eager?: boolean;
}
const { heading, gifts, eager = false } = Astro.props;
---

<section class="section">
  <h2 class="section-heading">{heading}</h2>
  <ul class="grid">
    {
      gifts.map((g, i) => (
        <li>
          {/* No title attribute: the hover panel shows the name, and the live Framer
              site has no native tooltip. Descriptions aren't shown anywhere on live either. */}
          <a class="card" href={g.link} target="_blank" rel="noopener" data-section={heading}>
            <span class="card-image">
              {/* aria-hidden: the image alt already gives the name to screen readers. */}
              <span class="card-title" aria-hidden="true"><span>{g.title}</span></span>
              <img
                src={g.image}
                alt={g.imageAlt}
                loading={eager && i < 10 ? "eager" : "lazy"}
                decoding="async"
                width="220"
                height="240"
              />
            </span>
            <span class="card-price">{formatPrice(g.price)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const card = event.target.closest<HTMLAnchorElement>(".card");
    if (!card) return;
    window.posthog?.capture("gift_link_clicked", {
      listing_section: card.dataset.section ?? "unknown",
    });
  });
</script>
