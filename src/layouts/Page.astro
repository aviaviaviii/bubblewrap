---
import { site } from "../site.config";
import Head from "../components/Head.astro";
import HeaderDots from "../components/HeaderDots.astro";

interface Props {
  title?: string;
  activeTag?: string;
}
const { title = site.title, activeTag } = Astro.props;
const marqueeItems = [...site.marquee, ...site.marquee];
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} />
  </head>
  <body>
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {marqueeItems.map((m) => <span>{m}<span class="flag">🇮🇳</span></span>)}
      </div>
    </div>
    <p class="intro">{site.intro}</p>

    <header class="header">
      <HeaderDots />
      <h1 class="logo">
        <a href="/"><span class="logo-full">bubble—wrap</span><span class="logo-short">b-w</span></a>
      </h1>
    </header>

    {/* The nav sticks to the top while the logo and dot field scroll away.
        It sits after the header, not inside it, because sticky only holds within
        its parent and the header is 207px tall. On desktop CSS pulls it back up
        over the header's top row, so at rest nothing moves. The sentinel marks
        where the nav rests; once that scrolls past, .is-stuck gives the bar a
        solid background so cards don't show through, and the dots stay visible
        at rest. */}
    <div class="nav-sentinel" aria-hidden="true"></div>
    <nav class="nav">
      <ul class="nav-tags">
        <li><a href="/" aria-current={!activeTag ? "page" : undefined}>ALL</a></li>
        {
          site.navTags.map((t) => (
            <li>
              <a href={`/${t}`} aria-current={activeTag === t ? "page" : undefined}>
                {t.toUpperCase()}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="nav-right">
        <li><button type="button" class="theme-toggle" id="theme-toggle">NIGHT</button></li>
        <li><a href={site.author.href} target="_blank" rel="noopener">{site.author.label}<span class="arrow"> ↗</span></a></li>
      </ul>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <p class="footer-label">• {site.newsletter.label}</p>
      {/* Posts to the Google Sheet's Apps Script (newsletter/apps-script.gs).
          "website" is a honeypot: hidden from people, so only bots fill it.
          "page" records where the signup happened. */}
      <form class="subscribe" method="POST" action={site.newsletter.action || undefined} data-success={site.newsletter.success} id="subscribe">
        <input type="email" name="email" placeholder="name@email.com" required autocomplete="email" aria-label="Email" />
        <input type="hidden" name="page" value={Astro.url.pathname} />
        <span class="hp" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></span>
        <button type="submit">Subscribe</button>
      </form>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById("theme-toggle");
        // Head.astro sets data-theme from the local time (or a recent tap) before paint.
        const isDark = () => root.dataset.theme === "dark";
        const sync = () => (btn.textContent = isDark() ? "DAY" : "NIGHT");

        // Sticky nav: solid only once it is actually stuck.
        const nav = document.querySelector(".nav");
        const sentinel = document.querySelector(".nav-sentinel");
        let queued = false;
        const stick = () => {
          queued = false;
          nav.classList.toggle("is-stuck", sentinel.getBoundingClientRect().top < 0);
        };
        addEventListener("scroll", () => {
          if (!queued) { queued = true; requestAnimationFrame(stick); }
        }, { passive: true });
        addEventListener("resize", stick);
        stick();
        sync();
        btn.addEventListener("click", () => {
          window.bwSetTheme(isDark() ? "light" : "dark");
          sync();
        });

        // Newsletter: send in the background, then show the /success page.
        // Apps Script doesn't allow reading the response cross-origin (no-cors), so a
        // request that reaches it counts as sent; only a network failure shows "Try again".
        const form = document.getElementById("subscribe");
        const button = form.querySelector("button");
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (!form.getAttribute("action")) { button.textContent = "Soon!"; return; }
          button.disabled = true;
          button.textContent = "Sending";
          try {
            await fetch(form.action, { method: "POST", mode: "no-cors", body: new URLSearchParams(new FormData(form)) });
            location.href = form.dataset.success;
          } catch {
            button.disabled = false;
            button.textContent = "Try again";
          }
        });
      })();
    </script>
  </body>
</html>
