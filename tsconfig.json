{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*",
    "e2e/**/*",
    "*.config.ts"
  ],
  "exclude": [
    "dist",
    ".vercel"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  }
}
